VITE_CLERK_PUBLISHABLE_KEY=

# Optional overrides. If unset in development, API uses the same hostname as the page:
#   open http://localhost:3000      → http://localhost:8080/api
#   open http://10.252.52.85:3000 → http://10.252.52.85:8080/api
# VITE_API_BASE_URL=http://10.252.52.85:8080/api
# VITE_SOCKET_URL=http://10.252.52.85:8080
#
# Production (Vercel → Render) — REQUIRED absolute API URL:
# VITE_API_BASE_URL=https://your-api.onrender.com/api
# VITE_SOCKET_URL=https://your-api.onrender.com
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
