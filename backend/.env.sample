PORT=8080
MONGODB_URI=mongodb://localhost:27017/spotify-clone
ADMIN_EMAIL=admin@example.com
NODE_ENV=development
# Comma-separated browser origins (LAN IP + localhost). Never use * with credentials.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://10.252.52.85:3000
# Production (Vercel) — also accepted:
# FRONTEND_URL=https://your-app.vercel.app
# === Airtel Cloud / Render / any production host — REQUIRED ===
# NODE_ENV=production
# JIOSAAVN_API_BASE_URL=https://shnwazdev-jiosaavn-apii.vercel.app
# JIOSAAVN_AUTHORIZED=true
# JIOSAAVN_API_TIMEOUT_MS=35000
# JIOSAAVN_API_RETRIES=3
# Never use http://localhost:3099 in production (cloud cannot reach your laptop).
# Rate limits (requests / IP / minute):
# RATE_LIMIT_MUSIC_MAX=90
# RATE_LIMIT_LIBRARY_MAX=60

# Optional — only required for admin media uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# SayaMusicAPI (discovery / charts / radio / previews)
SAYA_API_BASE_URL=https://sayamusicapi.sayaproject-mailflow.workers.dev
SAYA_API_TIMEOUT_MS=20000
SAYA_API_RETRIES=2
SAYA_SEARCH_CACHE_TTL_MS=60000

# Full-song JioSaavn API (shnwazdev-jiosaavn-api)
# Prefer a cloud URL so laptop restart / production does not kill catalog:
#   https://shnwazdev-jiosaavn-apii.vercel.app
# Local fallback: clone https://github.com/shnwazdeveloper/shnwazdev-jiosaavn-api
#   PORT=3099 npm run dev → http://localhost:3099
JIOSAAVN_API_BASE_URL=https://shnwazdev-jiosaavn-apii.vercel.app
JIOSAAVN_API_TIMEOUT_MS=35000
JIOSAAVN_API_RETRIES=3
JIOSAAVN_CACHE_TTL_MS=60000
JIOSAAVN_AUTHORIZED=true

# Search orchestration
# SEARCH_PROVIDER_TIMEOUT_MS=8000
# SEARCH_QUERY_CACHE_TTL_MS=45000
# SEARCH_PROVIDER_RETRIES=1
# SEARCH_CIRCUIT_FAILS=4
# SEARCH_CIRCUIT_COOLDOWN_MS=60000
# ITUNES_TIMEOUT_MS=8000

# MusicBrainz metadata (identify yourself per MB API etiquette)
# MUSICBRAINZ_USER_AGENT=MelodyPlay/1.0 (https://example.com; you@example.com)

# Jamendo Creative Commons full streams (free keys from developer.jamendo.com)
# JAMENDO_CLIENT_ID=
# JAMENDO_CLIENT_SECRET=   # optional — only needed for OAuth / user library
# JAMENDO_TIMEOUT_MS=12000
